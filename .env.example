# Copy this file to .env and put your own key there.
# Never put a real key in this file: it is uploaded to GitHub.

# ---- LLM provider -------------------------------------------------------
# Groq: free tier, no credit card. Keys: https://console.groq.com/keys
LLM_PROVIDER=groq
GROQ_API_KEY=your-groq-key-here
LLM_MODEL=openai/gpt-oss-120b

# xAI Grok (paid credits). Keys: https://console.x.ai
# LLM_PROVIDER=xai
# XAI_API_KEY=your-xai-key-here
# LLM_MODEL=grok-4-1-fast-non-reasoning

LLM_TEMPERATURE=0
LLM_REASONING_EFFORT=low

# ---- optional tuning ----------------------------------------------------
# SQL_MAX_RETRIES=3
# SQL_ROW_LIMIT=200
# RAG_TOP_K=4
# LLM_MAX_TOKENS=2048